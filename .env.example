# Environment Configuration Example for BizPocketHub

# Server Ports & Hosts
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (MongoDB connection string, or falls back to in-memory MongoDB for zero-config dev)
MONGODB_URI=mongodb://127.0.0.1:27017/bizpockethub
USE_MEMORY_DB=true

# Security & Sessions
JWT_SECRET=dev-jwt-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=dev-cookie-secret-min-32-characters-secure

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Media Uploads (Optional Cloudinary or Local uploads fallback)
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email (Optional SMTP or dev console logger fallback)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BizPocketHub <no-reply@bizpockethub.com>
